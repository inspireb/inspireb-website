    <script>
      // Popup Setmore : s'applique à TOUS les liens portant la classe js-setmore
      const modal = document.getElementById('setmore-modal');
      const iframe = document.getElementById('setmore-iframe') as HTMLIFrameElement | null;
      const closeBtn = document.getElementById('setmore-close');
      const overlay = document.getElementById('setmore-overlay');

      function openSetmore(url: string) {
        if (iframe) iframe.src = url;
        modal?.classList.remove('hidden');
        modal?.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
      function closeSetmore() {
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
        if (iframe) iframe.src = 'about:blank';
        document.body.style.overflow = '';
      }

      document.querySelectorAll('.js-setmore').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const url = btn.getAttribute('href');
          if (url) openSetmore(url);
        });
      });
      closeBtn?.addEventListener('click', closeSetmore);
      overlay?.addEventListener('click', closeSetmore);
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSetmore(); });
    </script>

    <!-- Script bannière du haut (promo ou ateliers) -->
    <script>
      // La bannière est masquée par défaut (classe "hidden") pour éviter tout
      // saut visuel : on ne l'affiche que si la visiteuse ne l'a pas déjà fermée.
      const bannerAteliers = document.getElementById('banner-ateliers');
      const siteHeader = document.getElementById('site-header');
      const mainEl = document.querySelector('main');

      // Quelle bannière afficher ? La promo si elle est en cours, sinon les ateliers.
      // Chaque bannière a sa propre mémoire « fermée » : fermer la promo ne
      // masque pas les ateliers, et inversement.
      const promoBtn = document.getElementById('banner-promo');
      const ateliersLien = document.getElementById('banner-ateliers-lien');
      const promoFin = bannerAteliers?.dataset.promoFin;
      const promoEnCours = Boolean(promoBtn && promoFin && new Date() < new Date(promoFin));

      let cleMemoire = 'inspireb_banner_ateliers';
      let contenuChoisi: HTMLElement | null = null;
      if (promoEnCours && promoBtn) {
        cleMemoire = 'inspireb_banner_promo';
        contenuChoisi = promoBtn;
        // Couleur propre à la promo (la bannière ateliers garde son vert)
        const couleurPromo = bannerAteliers?.dataset.promoCouleur;
        if (bannerAteliers && couleurPromo) bannerAteliers.style.backgroundColor = couleurPromo;
        // Le jour J, le texte change
        const aujourdhui = new Date().toLocaleDateString('fr-CA', { timeZone: 'Europe/Paris' });
        const texte = document.getElementById('banner-promo-texte');
        if (texte && aujourdhui === bannerAteliers?.dataset.promoJour && texte.dataset.jourJ) {
          texte.textContent = texte.dataset.jourJ;
        }
      } else if (ateliersLien) {
        contenuChoisi = ateliersLien;
        // Promo terminée : la bannière ateliers reprend son vert
        if (bannerAteliers) bannerAteliers.style.backgroundColor = '';
      }
      contenuChoisi?.classList.remove('hidden');

      // Fenêtre de la promo
      const promoDialog = document.getElementById('promo-dialog') as HTMLDialogElement | null;
      promoBtn?.addEventListener('click', () => promoDialog?.showModal());
      document.getElementById('promo-dialog-close')?.addEventListener('click', () => promoDialog?.close());
      promoDialog?.addEventListener('click', (e) => { if (e.target === promoDialog) promoDialog.close(); });

      // Encadré promo sur la page carte cadeau : visible seulement pendant la promo
      const encartPromo = document.getElementById('encart-promo');
      const encartFin = encartPromo?.dataset.promoFin;
      if (encartPromo && encartFin && new Date() < new Date(encartFin)) {
        // On le place juste sous le hero de la page (la première section
        // après l'encadré), pour garder le bandeau photo en haut.
        // (on saute les éventuels blocs invisibles, comme les données Schema.org)
        let hero = encartPromo.nextElementSibling;
        while (hero && ['SCRIPT', 'STYLE', 'LINK', 'META'].includes(hero.tagName)) {
          hero = hero.nextElementSibling;
        }
        if (hero) hero.after(encartPromo);
        encartPromo.classList.remove('hidden');
      }

      function decalerPourBanniere() {
        if (!bannerAteliers || bannerAteliers.classList.contains('hidden')) return;
        const hBanniere = bannerAteliers.offsetHeight;
        // ⚠️ Le <main> doit compenser la bannière ET l'en-tête, pas seulement
        // la bannière : sinon le haut du contenu passe sous le menu.
        const hEntete = siteHeader ? siteHeader.offsetHeight : 80;
        if (siteHeader) siteHeader.style.top = hBanniere + 'px';
        if (mainEl) mainEl.style.paddingTop = (hBanniere + hEntete) + 'px';
      }
      function fermerBanniere() {
        bannerAteliers?.classList.add('hidden');
        if (siteHeader) siteHeader.style.top = '0px';
        if (mainEl) mainEl.style.paddingTop = '';
        try { sessionStorage.setItem(cleMemoire, 'ferme'); } catch (e) {}
      }

      if (bannerAteliers && contenuChoisi) {
        let dejaFerme = false;
        try { dejaFerme = sessionStorage.getItem(cleMemoire) === 'ferme'; } catch (e) {}
        if (!dejaFerme) {
          bannerAteliers.classList.remove('hidden');
          decalerPourBanniere();
          window.addEventListener('resize', decalerPourBanniere);

          // Les polices web changent la hauteur de la bannière une fois
          // chargées : on recalcule pour éviter un décalage figé trop court.
          if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(decalerPourBanniere);
          }
          // Filet de sécurité si la bannière change de hauteur (rotation de
          // l'écran, zoom, texte plus long sur une autre page).
          if (window.ResizeObserver) {
            new ResizeObserver(decalerPourBanniere).observe(bannerAteliers);
          }
        }
        document.getElementById('banner-close')?.addEventListener('click', fermerBanniere);
      }
    </script>

