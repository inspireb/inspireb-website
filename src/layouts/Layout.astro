---
import { Icon } from 'astro-icon/components';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  /** Données structurées supplémentaires propres à la page (Service, FAQPage…) */
  schemaExtra?: any[];
  /**
   * Image de bandeau à charger en priorité.
   * Les images de fond CSS sont découvertes tard par le navigateur, ce qui
   * retarde l'affichage du premier écran. La signaler ici la fait charger
   * tout de suite.
   */
  preloadImage?: string;
}

const { title, description, canonical, ogImage, schemaExtra = [], preloadImage } = Astro.props;
const siteUrl = "https://www.inspireb.fr";
const currentUrl = canonical || siteUrl + Astro.url.pathname;
const ogImageUrl = ogImage ? siteUrl + ogImage : siteUrl + "/images/og-image.jpg";
import { services } from '../data/services.js';
import { ateliersAVenir } from '../data/ateliers.js';
import { soinsPages } from '../data/soinsPages.js';

// Sous-menu "Soins" : construit tout seul a partir des pages existantes.
// L'ordre suit celui de services.js, donc celui de la page /soins/ :
// pour reordonner le menu, il suffit de reordonner services.js.
// flatMap plutot que map + filter : on renvoie [] quand il n'y a pas de page,
// ce qui evite a TypeScript de croire que la liste peut contenir des null.
const sousMenuSoins = services.flatMap((s) => {
  const page = soinsPages.find((p) => p.serviceId === s.id);
  return page ? [{ href: `/soins/${page.slug}/`, label: s.categorie }] : [];
});

// Bannière ateliers : s'affiche seulement s'il reste un atelier à venir,
// et disparaît toute seule une fois la dernière date passée.
const prochainAtelier = ateliersAVenir()[0];
// Date courte du prochain atelier pour la bannière ("samedi 3 octobre")
const prochainAtelierDate = prochainAtelier
  ? new Date(prochainAtelier.debut).toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' })
  : '';
const surPageAteliers = Astro.url.pathname.startsWith('/ateliers');
const afficherAteliers = Boolean(prochainAtelier) && !surPageAteliers;

// ─── PROMO DU MOMENT ────────────────────────────────────────────────
// Tant que la promo est en cours, elle prend la place de la bannière
// ateliers (une seule bannière à la fois). Le lendemain de la date de fin,
// la bannière ateliers revient toute seule, sans rien toucher.
// Pour une prochaine promo : changer les textes, l'image et les dates ici.
const promo = {
  fin: '2026-11-28T00:00:00+01:00',  // la promo disparaît à cette date
  jour: '2026-11-27',                 // le jour J (le texte de la bannière change)
  texte: "Black Friday : le 27 novembre, jusqu'à 20 € offerts sur vos cartes cadeaux",
  texteJourJ: "Black Friday : c'est aujourd'hui ! Jusqu'à 20 € offerts sur vos cartes cadeaux",
  image: '/images/promo/carte-cadeau-black-friday.webp',
  imageAlt: "Carte cadeau InspireB, le 27 novembre : 50 € achetés, 10 € offerts, soit 60 € de bien-être à offrir. 100 € achetés, 20 € offerts, soit 120 € de bien-être à offrir.",
  lien: '/soins/carte-cadeau/',
  libelleBouton: 'Découvrir la carte cadeau',
  couleur: '#ab4210',        // couleur de la bannière promo (terracotta InspireB)
  // Encadré affiché en haut de la page "lien" pendant la promo
  encartTitre: 'Black Friday : le 27 novembre, jusqu\'à 20 € offerts',
  encartOffres: [
    { achat: '50 € achetés', bonus: '+ 10 € offerts', total: 'soit 60 € de bien-être à offrir' },
    { achat: '100 € achetés', bonus: '+ 20 € offerts', total: 'soit 120 € de bien-être à offrir' },
  ],
  encartComment: 'Pour en profiter, contactez-moi le 27 novembre par téléphone ou passez au cabinet.',
};
const surPagePromo = Astro.url.pathname === promo.lien;
// Vérifié au moment de la publication : si le site est republié après la fin
// de la promo, son code n'est même plus inclus dans les pages.
const promoPossible = new Date() < new Date(promo.fin);

const offers = services
  .filter(s => typeof s.schemaPrice === 'number')
  .map(s => ({
    "@type": "Offer",
    "itemOffered": { "@type": "Service", "name": s.categorie },
    "priceCurrency": "EUR",
    "price": String(s.schemaPrice),
    ...(s.schemaPrice === 0 ? { description: "Prix libre" } : {}),
  }));

const schema = {
  "@context": "https://schema.org",
  "@type": "HealthAndBeautyBusiness",
  "@id": siteUrl + "/#business",
  "name": "InspireB — Betty NOEL WOURMS",
  "description": "Praticienne beauté et bien-être à Sartilly-Baie-Bocage, entre Granville et Avranches. Massages bien-être, soins du visage et réflexologie plantaire, complétés par des outils de naturopathie, dans une approche personnalisée.",
  "url": siteUrl,
  "telephone": "+33646712096",
  "priceRange": "€€",
  "image": ogImageUrl,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "2 Rue des Iris",
    "addressLocality": "Sartilly-Baie-Bocage",
    "postalCode": "50530",
    "addressRegion": "Normandie",
    "addressCountry": "FR",
  },
  "geo": { "@type": "GeoCoordinates", "latitude": "48.754920360832486", "longitude": "-1.4511759853949815" },
  "areaServed": [
    { "@type": "City", "name": "Sartilly-Baie-Bocage" },
    { "@type": "City", "name": "Granville" },
    { "@type": "City", "name": "Avranches" },
    { "@type": "City", "name": "Saint-Pair-sur-Mer" },
    { "@type": "City", "name": "Jullouville" },
    { "@type": "City", "name": "La Haye-Pesnel" },
  ],
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Monday", "opens": "09:00", "closes": "15:45" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Tuesday", "opens": "09:00", "closes": "15:45" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Wednesday", "opens": "09:30", "closes": "16:00" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Thursday", "opens": "09:00", "closes": "15:45" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Friday", "opens": "09:00", "closes": "15:45" },
    { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "13:00" },
  ],
  "sameAs": [
    "https://www.instagram.com/betty_inspireb",
    "https://www.facebook.com/p/InspireB-Betty-NW-61574083089520/",
    "https://www.linkedin.com/in/betty-noel-wourms-43a2b9416",
    "https://www.resalib.fr/praticien/126051-inspireb-institut-de-beaute-sartilly-baie-bocage",
  ],
  "makesOffer": offers,
  // Note : pas d'aggregateRating ici. Google n'affiche pas d'étoiles pour les avis
  // qu'une entreprise publie sur son propre site (« self-serving »), et un tel balisage
  // peut entraîner une pénalité. Les avis et étoiles vivent sur la fiche Google Business.
};
---

<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={currentUrl} />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="icon" type="image/svg+xml" href="/images/Logo_InspireB.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImageUrl} />

    <!-- Schema.org LocalBusiness (+ schémas propres à la page) -->
    <script type="application/ld+json" set:html={JSON.stringify(
      schemaExtra.length
        ? { "@context": "https://schema.org", "@graph": [schema, ...schemaExtra] }
        : schema
    )} />

    <title>{title}</title>

    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <!-- Fonts : Dancing Script (logo) + Plus Jakarta Sans (textes, proche de Clear Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#f6f6e9] text-[#4A4A4A] font-jakarta">

    <!-- BANNIÈRE DU HAUT : la promo en cours si elle existe, sinon les ateliers
         (une seule bannière à la fois, choisie par le script plus bas) -->
    {(afficherAteliers || promoPossible) && (
      <div id="banner-ateliers" class="hidden fixed top-0 left-0 right-0 z-[60] bg-[#5a9480] text-white"
           data-promo-fin={promoPossible ? promo.fin : undefined}
           data-promo-jour={promoPossible ? promo.jour : undefined}
           data-promo-couleur={promoPossible ? promo.couleur : undefined}
           style={promoPossible ? `background-color:${promo.couleur};` : undefined}>
        <div class="max-w-6xl mx-auto px-4 py-2.5 flex items-center justify-center gap-3 text-center">

          {promoPossible && (
            <button type="button" id="banner-promo" class="hidden flex-1 text-sm leading-snug hover:underline underline-offset-2 cursor-pointer">
              <span>🎁 </span>
              <span id="banner-promo-texte" class="font-medium" data-jour-j={promo.texteJourJ}>{promo.texte}</span>
              <span class="whitespace-nowrap underline underline-offset-2 ml-1">Voir l'offre →</span>
            </button>
          )}

          {afficherAteliers && (
            <a href="/ateliers/" id="banner-ateliers-lien" class="hidden flex-1 text-sm leading-snug hover:underline underline-offset-2">
              <span class="font-medium">Découvrir les ateliers à venir</span>
              <span class="hidden sm:inline text-white/75"> · prochain rendez-vous le {prochainAtelierDate}</span>
              <span class="whitespace-nowrap"> →</span>
            </a>
          )}

          <button id="banner-close" aria-label="Fermer l'annonce"
                  class="text-white/60 hover:text-white text-xl leading-none px-2 flex-shrink-0 transition-colors">×</button>
        </div>
      </div>
    )}

    <!-- FENÊTRE DE LA PROMO (s'ouvre au clic sur la bannière) -->
    {promoPossible && (
      <dialog id="promo-dialog" aria-label="Offre du moment"
              class="m-auto p-0 border-0 rounded-2xl w-[min(92vw,calc((100vh-9rem)*1.414),48rem)] max-h-[96vh] overflow-auto bg-[#f6f6e9] shadow-2xl backdrop:bg-[#24392e]/60 backdrop:backdrop-blur-sm">
        <div class="relative">
          <button type="button" id="promo-dialog-close" aria-label="Fermer"
                  class="absolute right-2.5 top-2.5 w-10 h-10 rounded-full bg-white/85 text-2xl leading-none text-[#3D3D3D] hover:bg-white transition-colors">×</button>
          <img src={promo.image} alt={promo.imageAlt} width="1400" height="990" loading="lazy"
               class="block w-full h-auto rounded-t-2xl" />
          <div class="px-5 pt-3 pb-4 text-center">
            <a href={promo.lien} style={`background-color:${promo.couleur};`}
               class="inline-block text-white px-8 py-3.5 rounded-full hover:opacity-90 transition-opacity text-sm tracking-wide font-medium">
              {promo.libelleBouton}
            </a>
          </div>
        </div>
      </dialog>
    )}

    <!-- NAVIGATION -->
    <header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-[#f6f6e9]/95 backdrop-blur-sm border-b border-[#dde7e0]">
      <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3">
          <img src="/images/Logo_InspireB.svg" alt="InspireB logo" class="h-14 w-auto" />
          <span class="flex flex-col leading-tight">
            <span class="font-dancing text-2xl text-black">InspireB</span>
            <span class="text-[0.6rem] tracking-[0.12em] uppercase text-[#4A4A4A]/60">Praticienne Bien-être & Naturopathe</span>
          </span>
        </a>

        <!-- Menu desktop -->
        <ul class="hidden md:flex items-center gap-8 text-sm tracking-wide">
          <li><a href="/" class="hover:text-[#a8cbb7] transition-colors">Accueil</a></li>
          <li><a href="/concept/" class="hover:text-[#a8cbb7] transition-colors">Le concept</a></li>
          <li class="relative group">
            <a href="/soins/" class="hover:text-[#a8cbb7] transition-colors inline-flex items-center gap-1">
              Soins & Tarifs
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"
                   class="opacity-50 group-hover:rotate-180 transition-transform"><path d="M6 9l6 6 6-6"/></svg>
            </a>
            <div class="absolute left-0 top-full pt-3 hidden group-hover:block group-focus-within:block">
              <ul class="bg-[#f6f6e9] border border-[#dde7e0] rounded-2xl shadow-lg py-2 min-w-[15rem]">
                {sousMenuSoins.map((item) => (
                  <li>
                    <a href={item.href} class="block px-5 py-2.5 hover:bg-[#eaf1ec] hover:text-[#5a9480] transition-colors">{item.label}</a>
                  </li>
                ))}
                <li class="border-t border-[#dde7e0] mt-2 pt-2">
                  <a href="/soins/" class="block px-5 py-2.5 text-[#5a9480] font-medium hover:bg-[#eaf1ec] transition-colors">Toutes les prestations →</a>
                </li>
              </ul>
            </div>
          </li>
          <li><a href="/ateliers/" class="hover:text-[#a8cbb7] transition-colors">Ateliers</a></li>
          <li><a href="/a-propos/" class="hover:text-[#a8cbb7] transition-colors">À propos</a></li>
          <li><a href="/blog/" class="hover:text-[#a8cbb7] transition-colors">Blog</a></li>
          <li><a href="/contact/" class="hover:text-[#a8cbb7] transition-colors">Contact</a></li>
        </ul>

        <!-- Menu burger mobile -->
        <button id="menu-toggle" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menu">
          <span class="w-6 h-0.5 bg-[#4A4A4A] transition-all" id="bar1"></span>
          <span class="w-6 h-0.5 bg-[#4A4A4A] transition-all" id="bar2"></span>
          <span class="w-6 h-0.5 bg-[#4A4A4A] transition-all" id="bar3"></span>
        </button>
      </nav>

      <!-- Menu mobile déroulant -->
      <div id="mobile-menu" class="hidden md:hidden bg-[#f6f6e9] border-t border-[#dde7e0] px-6 py-4">
        <ul class="flex flex-col gap-4 text-sm">
          <li><a href="/" class="block hover:text-[#a8cbb7]">Accueil</a></li>
          <li><a href="/concept/" class="block hover:text-[#a8cbb7]">Le concept</a></li>
          <li>
            <a href="/soins/" class="block hover:text-[#a8cbb7]">Soins & Tarifs</a>
            <ul class="mt-2 ml-4 pl-3 border-l border-[#dde7e0] flex flex-col gap-2.5 text-[0.8rem] text-[#4A4A4A]/70">
              {sousMenuSoins.map((item) => (
                <li><a href={item.href} class="block hover:text-[#5a9480]">{item.label}</a></li>
              ))}
            </ul>
          </li>
          <li><a href="/ateliers/" class="block hover:text-[#a8cbb7]">Ateliers</a></li>
          <li><a href="/a-propos/" class="block hover:text-[#a8cbb7]">À propos</a></li>
          <li><a href="/blog/" class="block hover:text-[#a8cbb7]">Blog</a></li>
          <li><a href="/contact/" class="block hover:text-[#a8cbb7]">Contact</a></li>
        </ul>
      </div>
    </header>

    <!-- CONTENU PRINCIPAL -->
    <main class="pt-20">
      <!-- ENCADRÉ PROMO (uniquement sur la page de la promo, et seulement pendant la promo) -->
      {promoPossible && surPagePromo && (
        <section id="encart-promo" class="hidden px-6 py-10 md:py-12 bg-white" data-promo-fin={promo.fin}>
          <div class="max-w-4xl mx-auto bg-[#eaf1ec] border border-[#a8cbb7] rounded-3xl px-6 md:px-10 py-7 text-center">
            <p class="text-[#5a9480] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-2">🎁 Offre du moment</p>
            <h2 class="font-jakarta font-medium text-2xl md:text-3xl text-[#3D3D3D] mb-5">{promo.encartTitre}</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-w-2xl mx-auto mb-5">
              {promo.encartOffres.map((o) => (
                <div class="bg-white/80 rounded-2xl px-5 py-4">
                  <p class="text-sm text-[#4A4A4A]/70">{o.achat}</p>
                  <p class="font-jakarta font-semibold text-xl text-[#5a9480]">{o.bonus}</p>
                  <p class="text-xs text-[#4A4A4A]/60 mt-0.5">{o.total}</p>
                </div>
              ))}
            </div>
            <p class="text-sm text-[#4A4A4A]/70 mb-5">{promo.encartComment}</p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <a href="tel:+33646712096"
                 class="bg-[#5a9480] text-white px-7 py-3 rounded-full hover:bg-[#4a7f6c] transition-colors text-sm tracking-wide font-medium">
                Appeler le 06 46 71 20 96
              </a>
              <a href="/contact/"
                 class="border-2 border-[#a8cbb7] text-[#5a9480] px-7 py-2.5 rounded-full hover:bg-white transition-colors text-sm tracking-wide font-medium">
                Me contacter
              </a>
            </div>
          </div>
        </section>
      )}
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="bg-[#5a9480] text-white mt-20">
      <div class="max-w-6xl mx-auto px-6 py-12 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
        <div>
          <h3 class="font-dancing text-3xl mb-3">InspireB</h3>
          <p class="text-sm text-white/70 leading-relaxed">
            Praticienne Bien-être & Naturopathe<br />
            à Sartilly-Baie-Bocage.<br />
            Prendre soin de vous, de l'intérieur comme de l'extérieur.
          </p>
          <!-- Réseaux sociaux (icônes) → remplacez les URLs par les vôtres -->
          <div class="flex gap-3 mt-4">
            <a href="https://www.instagram.com/betty_inspireb" target="_blank" rel="noopener" aria-label="Instagram"
               class="bg-white/15 hover:bg-white/30 transition-colors rounded-full p-2.5 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2c-2.717 0-3.056.012-4.122.06-1.065.05-1.79.217-2.428.465a4.88 4.88 0 0 0-1.772 1.153A4.897 4.897 0 0 0 2.525 5.45c-.247.637-.415 1.363-.465 2.428C2.012 8.944 2 9.283 2 12s.012 3.056.06 4.122c.05 1.066.218 1.792.465 2.428a4.883 4.883 0 0 0 1.153 1.772 4.897 4.897 0 0 0 1.772 1.153c.637.247 1.363.415 2.428.465C8.944 21.988 9.283 22 12 22s3.056-.012 4.122-.06c1.066-.05 1.792-.218 2.428-.465a4.89 4.89 0 0 0 1.772-1.153 4.904 4.904 0 0 0 1.153-1.772c.247-.637.415-1.363.465-2.428C21.988 15.056 22 14.717 22 12s-.012-3.056-.06-4.122c-.05-1.066-.218-1.792-.465-2.428a4.89 4.89 0 0 0-1.153-1.772A4.897 4.897 0 0 0 18.55 2.525c-.637-.247-1.363-.415-2.428-.465C15.056 2.012 14.717 2 12 2zm0 1.802c2.67 0 2.987.01 4.04.058.974.045 1.504.207 1.857.344.467.182.8.399 1.15.748.35.35.566.683.748 1.15.137.353.3.883.344 1.857.048 1.053.058 1.37.058 4.04s-.01 2.987-.058 4.04c-.045.974-.207 1.504-.344 1.857-.182.467-.399.8-.748 1.15-.35.35-.683.566-1.15.748-.353.137-.883.3-1.857.344-1.053.048-1.37.058-4.04.058s-2.987-.01-4.04-.058c-.974-.045-1.504-.207-1.857-.344-.467-.182-.8-.399-1.15-.748-.35-.35-.566-.683-.748-1.15-.137-.353-.3-.883-.344-1.857-.048-1.053-.058-1.37-.058-4.04s.01-2.987.058-4.04c.045-.974.207-1.504.344-1.857.182-.467.399-.8.748-1.15.35-.35.683-.566 1.15-.748.353-.137.883-.3 1.857-.344 1.053-.048 1.37-.058 4.04-.058zM12 6.865a5.135 5.135 0 1 0 0 10.27 5.135 5.135 0 0 0 0-10.27zm0 8.468a3.333 3.333 0 1 1 0-6.666 3.333 3.333 0 0 1 0 6.666zm6.538-8.671a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/>
              </svg>
            </a>
            <a href="https://www.facebook.com/p/InspireB-Betty-NW-61574083089520/" target="_blank" rel="noopener" aria-label="Facebook"
               class="bg-white/15 hover:bg-white/30 transition-colors rounded-full p-2.5 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
              </svg>
            </a>
            <a href="https://www.linkedin.com/in/betty-noel-wourms-43a2b9416" target="_blank" rel="noopener" aria-label="LinkedIn"
               class="bg-white/15 hover:bg-white/30 transition-colors rounded-full p-2.5 flex items-center justify-center">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
