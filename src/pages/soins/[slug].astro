---
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import { services } from '../../data/services.js';
import { soinsPages, acces, communes } from '../../data/soinsPages.js';

// Génère une page par entrée de soinsPages.js
export function getStaticPaths() {
  return soinsPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props;

// On récupère les tarifs depuis services.js : jamais de prix saisi deux fois.
const service = services.find((s) => s.id === page.serviceId);
const siteUrl = 'https://www.inspireb.fr';
const pageUrl = `${siteUrl}/soins/${page.slug}/`;

// ---- Données structurées propres à cette page -------------------------------
const schemaService = {
  '@type': 'Service',
  '@id': pageUrl + '#service',
  name: service.categorie,
  serviceType: service.categorie,
  description: page.seoDescription,
  url: pageUrl,
  provider: { '@id': siteUrl + '/#business' },
  areaServed: [
    { '@type': 'City', name: 'Granville' },
    { '@type': 'City', name: 'Avranches' },
    { '@type': 'City', name: 'Sartilly-Baie-Bocage' },
    ...communes.map((c) => ({ '@type': 'City', name: c })),
  ],
  ...(typeof service.schemaPrice === 'number'
    ? {
        offers: {
          '@type': 'Offer',
          price: String(service.schemaPrice),
          priceCurrency: 'EUR',
          availability: 'https://schema.org/InStock',
          url: 'https://inspireb.setmore.com/#services',
          ...(service.schemaPrice === 0 ? { description: 'Prix libre' } : {}),
        },
      }
    : {}),
};

const schemaFaq = {
  '@type': 'FAQPage',
  '@id': pageUrl + '#faq',
  mainEntity: page.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.r },
  })),
};

const schemaBreadcrumb = {
  '@type': 'BreadcrumbList',
  '@id': pageUrl + '#breadcrumb',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: siteUrl + '/' },
    { '@type': 'ListItem', position: 2, name: 'Soins & Tarifs', item: siteUrl + '/soins/' },
    { '@type': 'ListItem', position: 3, name: service.categorie, item: pageUrl },
  ],
};

// Les autres prestations, pour le maillage interne en bas de page
const autresPages = soinsPages.filter((p) => p.slug !== page.slug);
---

<Layout
  title={page.seoTitle}
  description={page.seoDescription}
  ogImage={page.image}
  schemaExtra={[schemaService, schemaFaq, schemaBreadcrumb]}
>

  <!-- HERO -->
  <section class="js-hide-cta relative py-12 md:py-16 px-6 text-center overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center" style={`background-image:url('${page.heroImage || page.image}')`}>
      <div class="absolute inset-0 bg-[#eaf1ec]/50"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_55%_80%_at_center,_#eaf1ec_0%,_#eaf1ec_38%,_transparent_100%)]"></div>
    </div>

    <div class="relative z-10 max-w-3xl mx-auto">
      <!-- Fil d'ariane -->
      <nav aria-label="Fil d'ariane" class="text-xs text-[#4A4A4A]/50 mb-4">
        <a href="/" class="hover:text-[#5a9480] transition-colors">Accueil</a>
        <span class="mx-1.5">›</span>
        <a href="/soins/" class="hover:text-[#5a9480] transition-colors">Soins & Tarifs</a>
        <span class="mx-1.5">›</span>
        <span class="text-[#4A4A4A]/70">{service.categorie}</span>
      </nav>

      <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">{page.eyebrow}</p>
      <h1 class="font-jakarta font-medium text-4xl md:text-5xl text-[#3D3D3D] mb-4 leading-tight">
        {page.h1}
        <span class="block text-xl md:text-2xl text-[#5a9480] mt-1.5">{page.h1Suite}</span>
      </h1>
      <p class="text-base md:text-lg text-[#4A4A4A]/70 leading-relaxed max-w-xl mx-auto">{page.chapo}</p>

      <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
        <a href="https://inspireb.setmore.com/#services"
           class="js-setmore bg-[#a8cbb7] text-white px-8 py-3.5 rounded-full hover:bg-[#5a9480] transition-colors text-sm tracking-wide font-medium">
          Réserver ma séance
        </a>
        <a href="/soins/"
           class="border-2 border-[#a8cbb7] text-[#5a9480] px-8 py-3 rounded-full hover:bg-[#eaf1ec] transition-colors text-sm tracking-wide font-medium">
          Voir tous les soins
        </a>
      </div>
    </div>
  </section>

  <!-- TARIFS (récupérés depuis services.js) -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">Tarifs</p>
        <h2 class="font-jakarta font-medium text-4xl text-[#3D3D3D]">{service.categorie}</h2>
      </div>

      <div class="border border-[#dde7e0] rounded-2xl overflow-hidden">
        {service.items.map((item, j) => (
          <div class={`flex flex-wrap items-center justify-between gap-4 px-6 py-5 ${j < service.items.length - 1 ? 'border-b border-[#dde7e0]' : ''} hover:bg-[#eaf1ec] transition-colors`}>
            <div class="min-w-[12rem] flex-1">
              <p class="font-medium text-[#3D3D3D]">{item.nom}</p>
              <p class="text-xs text-[#4A4A4A]/50 mt-0.5 flex items-center gap-1">
                <Icon name="ph:clock-fill" size={12} class="flex-shrink-0" />
                <span>{item.duree}</span>
              </p>
            </div>
            <div class="flex items-center gap-4 flex-shrink-0">
              {typeof item.prix === 'number' ? (
                <span class="font-jakarta font-medium text-xl md:text-2xl text-[#a8cbb7] whitespace-nowrap">{item.prix} €</span>
              ) : (
                <span class="text-base font-medium text-[#a8cbb7] text-right max-w-[140px] uppercase tracking-wide">{item.prix}</span>
              )}
              {/* Le bouton n'apparaît que si la formule a un lien de réservation
                  direct. Sinon (carte cadeau, Séréni'Baie…), on laisse la note
                  ou le tarif parler : pas de bouton qui mène nulle part. */}
              {item.lienSetmore && (
                <a href={item.lienSetmore}
                   class="js-setmore border border-[#a8cbb7] text-[#5a9480] px-4 py-2 rounded-full text-xs font-medium hover:bg-[#a8cbb7] hover:text-white transition-colors whitespace-nowrap">
                  Réserver
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

      {service.note && (
        <p class="text-sm text-[#4A4A4A]/70 leading-relaxed bg-[#eaf1ec] rounded-xl px-5 py-4 mt-4">
          {service.note}
        </p>
      )}

      <p class="text-xs text-[#4A4A4A]/50 italic text-center mt-4">
        La durée indiquée est le temps de soin. Le temps à prévoir sur place inclut l'accueil, le bilan et les conseils personnalisés.
      </p>
    </div>
  </section>

  <!-- PRÉSENTATION + IMAGE -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-5xl mx-auto space-y-16">
      {page.sections.map((bloc, i) => (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
          <div class={i % 2 === 0 ? 'md:order-2' : 'md:order-1'}>
            <img
              src={bloc.image || page.image}
              alt={bloc.imageAlt || page.imageAlt}
              loading="lazy"
              class={`w-full h-72 md:h-96 rounded-3xl bg-[#eaf1ec] ${bloc.imageFit === 'contain' ? 'object-contain p-6' : 'object-cover'}`}
            />
          </div>
          <div class={i % 2 === 0 ? 'md:order-1' : 'md:order-2'}>
            <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">{bloc.eyebrow}</p>
            <h2 class="font-jakarta font-medium text-3xl text-[#3D3D3D] mb-5">{bloc.titre}</h2>
            {bloc.paragraphes.map((p) => (
              <p class="text-sm text-[#4A4A4A]/70 leading-relaxed mb-4"
                 set:html={p.replace(/\*\*(.+?)\*\*/g, '<strong class="text-[#3D3D3D] font-medium">$1</strong>')} />
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  {page.etapes && (
  <!-- DÉROULÉ DE LA SÉANCE -->
  <section class="py-16 px-6 bg-[#f6f6e9]">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">En pratique</p>
        <h2 class="font-jakarta font-medium text-4xl text-[#3D3D3D]">{page.etapesTitre}</h2>
      </div>

      <div class="space-y-4">
        {page.etapes.map((etape, i) => (
          <div class="bg-white rounded-2xl p-6 flex gap-5 items-start">
            <span class="font-jakarta font-medium text-3xl text-[#a8cbb7] leading-none flex-shrink-0 w-10">
              {i + 1}
            </span>
            <div>
              <h3 class="font-jakarta font-medium text-lg text-[#5a9480] mb-1">{etape.titre}</h3>
              <p class="text-sm text-[#4A4A4A]/70 leading-relaxed">{etape.texte}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
  )}

  <!-- POUR QUI -->
  <section class="py-16 px-6 bg-[#eaf1ec]">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">Est-ce pour vous ?</p>
        <h2 class="font-jakarta font-medium text-4xl text-[#3D3D3D]">Cette séance est faite pour vous si…</h2>
      </div>
      <ul class="space-y-3">
        {page.pourQui.map((item) => (
          <li class="bg-white rounded-xl px-5 py-4 flex items-start gap-3">
            <Icon name="ph:check-circle-fill" size={20} class="text-[#a8cbb7] flex-shrink-0 mt-0.5" />
            <span class="text-sm text-[#4A4A4A]/80 leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- VENIR ME VOIR (contenu local) -->
  {!page.masquerAcces && (
  <section class="py-16 px-6 bg-white">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">Venir me voir</p>
        <h2 class="font-jakarta font-medium text-4xl text-[#3D3D3D] mb-4">Où se passe la séance</h2>
        <p class="text-sm text-[#4A4A4A]/70 max-w-xl mx-auto">{page.accesIntro}</p>
      </div>

      <div class="bg-[#f6f6e9] rounded-3xl p-6 md:p-8">
        <div class="flex flex-wrap items-start gap-x-10 gap-y-6">

          <div class="flex items-start gap-3">
            <Icon name="ph:map-pin-fill" size={22} class="text-[#a8cbb7] flex-shrink-0 mt-0.5" />
            <p class="text-sm text-[#4A4A4A]/80 leading-relaxed">
              <strong class="text-[#3D3D3D] font-medium">2 rue des Iris</strong><br />
              50530 Sartilly-Baie-Bocage
            </p>
          </div>

          <div class="flex items-start gap-3">
            <Icon name="ph:car-profile-fill" size={22} class="text-[#a8cbb7] flex-shrink-0 mt-0.5" />
            <p class="text-sm text-[#4A4A4A]/80 leading-relaxed">
              <strong class="text-[#3D3D3D] font-medium">Stationnement gratuit</strong><br />
              devant le cabinet, sans tourner
            </p>
          </div>

          {acces.map((a) => (
            <div class="flex items-start gap-3">
              <Icon name="ph:clock-fill" size={22} class="text-[#a8cbb7] flex-shrink-0 mt-0.5" />
              <p class="text-sm text-[#4A4A4A]/80 leading-relaxed">
                <strong class="text-[#3D3D3D] font-medium">{a.duree} depuis {a.ville}</strong><br />
                {a.route}
              </p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>
  )}

  <!-- FAQ -->
  <section class="py-16 px-6 bg-[#f6f6e9]">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">Questions fréquentes</p>
        <h2 class="font-jakarta font-medium text-4xl text-[#3D3D3D]">Ce qu'on me demande souvent</h2>
      </div>

      <div class="space-y-3">
        {page.faq.map((f, i) => (
          <details class="bg-white rounded-2xl px-6 py-5 group" open={i === 0}>
            <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-jakarta font-medium text-[#5a9480]">
              <span>{f.q}</span>
              <Icon name="ph:plus-bold" size={16} class="text-[#a8cbb7] flex-shrink-0 group-open:rotate-45 transition-transform" />
            </summary>
            <p class="text-sm text-[#4A4A4A]/70 leading-relaxed mt-4">{f.r}</p>
          </details>
        ))}
      </div>

      <p class="text-xs text-[#4A4A4A]/50 italic leading-relaxed mt-8 text-center">{page.disclaimer}</p>
    </div>
  </section>

  <!-- AUTRES PRESTATIONS (maillage interne) -->
  <section class="py-16 px-6 bg-white">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-10">
        <p class="text-[#a8cbb7] text-[0.65rem] sm:text-xs tracking-[0.15em] sm:tracking-[0.3em] uppercase mb-3">Aller plus loin</p>
        <h2 class="font-jakarta font-medium text-4xl text-[#3D3D3D]">Mes autres prestations</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {autresPages.map((p) => {
          const s = services.find((x) => x.id === p.serviceId);
          return (
            <a href={`/soins/${p.slug}/`}
               class="bg-[#f6f6e9] rounded-2xl p-6 hover:shadow-md transition-shadow group flex flex-col justify-between h-full">
              <div>
                <h3 class="font-jakarta font-medium text-xl text-[#3D3D3D] mb-2 group-hover:text-[#a8cbb7] transition-colors">{s.categorie}</h3>
                <p class="text-sm text-[#4A4A4A]/60 leading-relaxed mb-3">{s.descCourt}</p>
              </div>
              <span class="text-[#a8cbb7] text-sm font-medium">{s.apercu}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 px-6 bg-[#5a9480] text-white text-center">
    <div class="max-w-xl mx-auto">
      <h2 class="font-jakarta font-medium text-4xl mb-4">Envie de réserver ?</h2>
      <p class="text-white/70 mb-8">Réservation en ligne 24h/24, ou par téléphone si vous préférez qu'on en parle avant.</p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href="https://inspireb.setmore.com/#services"
           class="js-setmore bg-white text-[#5a9480] px-8 py-3.5 rounded-full hover:bg-[#eaf1ec] transition-colors text-sm tracking-wide font-medium">
          Réserver en ligne →
        </a>
        <a href="tel:+33646712096"
           class="border-2 border-white/60 text-white px-8 py-3 rounded-full hover:bg-white/10 transition-colors text-sm tracking-wide font-medium">
          06 46 71 20 96
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  details > summary::-webkit-details-marker { display: none; }
</style>
